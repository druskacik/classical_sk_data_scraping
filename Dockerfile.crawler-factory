FROM python:3.12-slim

ARG PLAYWRIGHT_MCP_VERSION=0.0.78
ARG GITHUB_CLI_VERSION=2.94.0

WORKDIR /factory

COPY pyproject.toml uv.lock README.md ./

RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates chromium curl git libpq-dev nodejs npm tzdata && \
    gh_arch="$(dpkg --print-architecture)" && \
    case "$gh_arch" in \
        amd64) gh_asset_arch="amd64"; gh_sha256="d4504b534417965f833a59b40a36e0138b24528658d721df15c5e8a14e51a944" ;; \
        arm64) gh_asset_arch="arm64"; gh_sha256="6ea8b44936bb04219de6653fc9a676995dd44ce18c93e5922a97afe06a75c42e" ;; \
        i386) gh_asset_arch="386"; gh_sha256="9ed41afc808d4438aa10671d246fb75ad1d26aeb02009faf3a27788878b784cb" ;; \
        armhf) gh_asset_arch="armv6"; gh_sha256="eb6087115dcf6af75438b70b4bb887f0342541022eb1bb56110ac52925728f86" ;; \
        *) echo "Unsupported architecture for GitHub CLI: $gh_arch" >&2; exit 1 ;; \
    esac && \
    gh_package="gh_${GITHUB_CLI_VERSION}_linux_${gh_asset_arch}.deb" && \
    curl --fail --location --silent --show-error \
        "https://github.com/cli/cli/releases/download/v${GITHUB_CLI_VERSION}/${gh_package}" \
        --output "/tmp/${gh_package}" && \
    echo "${gh_sha256}  /tmp/${gh_package}" | sha256sum --check --strict && \
    apt-get install -y --no-install-recommends "/tmp/${gh_package}" && \
    gh --version | grep --fixed-strings "gh version ${GITHUB_CLI_VERSION}" && \
    rm -f "/tmp/${gh_package}" && \
    rm -rf /var/lib/apt/lists/*

COPY . .

RUN unset http_proxy https_proxy HTTP_PROXY HTTPS_PROXY && \
    pip install --no-cache-dir . && \
    npm install --global "@playwright/mcp@${PLAYWRIGHT_MCP_VERSION}" && \
    ln -s "$(python -c 'from codex_cli_bin import bundled_codex_path; print(bundled_codex_path())')" \
        /usr/local/bin/codex

ARG CAPROVER_GIT_COMMIT_SHA

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    HOME=/factory-home \
    CODEX_HOME=/factory-codex-home \
    PLAYWRIGHT_MCP_EXECUTABLE_PATH=/usr/bin/chromium \
    PLAYWRIGHT_MCP_HEADLESS=true \
    PLAYWRIGHT_MCP_NO_SANDBOX=true \
    CRAWLER_FACTORY_REPOSITORY=https://github.com/druskacik/classical_bot.git \
    CRAWLER_FACTORY_MODE=continuous \
    CRAWLER_FACTORY_SCHEDULE_TIME=06:00 \
    CRAWLER_FACTORY_TIMEZONE=Europe/Prague \
    CRAWLER_FACTORY_UPDATE_INTERVAL_MINUTES=5 \
    CRAWLER_FACTORY_IDLE_INTERVAL_MINUTES=5 \
    CRAWLER_FACTORY_FAILURE_BACKOFF_MINUTES=15 \
    CRAWLER_FACTORY_PR_POLL_INTERVAL_MINUTES=1 \
    CRAWLER_FACTORY_MAX_URLS=5 \
    CRAWLER_FACTORY_TIMEOUT_MINUTES=60 \
    CRAWLER_FACTORY_VALIDATION_TIMEOUT_MINUTES=15 \
    LOG_SERVICE=classical-crawler-factory \
    LOG_LEVEL=INFO \
    CAPROVER_GIT_COMMIT_SHA=${CAPROVER_GIT_COMMIT_SHA}

VOLUME ["/var/lib/crawler-factory", "/factory-home", "/factory-codex-home"]

CMD ["python", "-m", "automation.run_crawler_factory_service"]
